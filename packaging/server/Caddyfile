# Front of banc-server: TLS on port 443 with a Let's Encrypt certificate, the
# relay paths to the iroh relay, everything else to the API and the web admin.
{
	servers {
		# No HTTP/3: UDP 443 belongs to the server's iroh endpoint.
		protocols h1 h2
	}
}

{$BANC_DOMAIN} {
	@relay path /relay /relay/* /ping /generate_204
	reverse_proxy @relay banc-server:3340
	reverse_proxy banc-server:8080
}
